# ─── Smart Riayah Backend & Frontend — Environment Variables Example ─────────────
# Salin file ini menjadi .env atau .env.local dan isi dengan kredensial rahasia Anda.
# JANGAN PERNAH commit file .env atau .env.local yang berisi token asli ke GitHub!

# ─── Database PostgreSQL / Supabase ──────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=smart_riayah_db
DB_NAME=smart_riayah_db
DB_USERNAME=postgres
DB_USER=postgres
DB_PASSWORD=your_database_password_here
DATABASE_URL=postgresql://postgres:[PASSWORD]@[HOST]:5432/[DB_NAME]

# ─── Supabase Configuration ──────────────────────────────────────────────────
# Didapatkan dari: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_supabase_anon_key_here
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=sb_publishable_your_supabase_anon_key_here
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=sb_publishable_your_supabase_anon_key_here

# ─── Google Gemini AI ────────────────────────────────────────────────────────
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# ─── DeepSeek AI Engine ──────────────────────────────────────────────────────
# Didapatkan dari: https://platform.deepseek.com/api_keys
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
DEEPSEEK_MODEL=deepseek-chat
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here
VITE_DEEPSEEK_BASE_URL=https://api.deepseek.com/v1/chat/completions
VITE_DEEPSEEK_MODEL=deepseek-chat

# ─── Fonnte WhatsApp Gateway API ─────────────────────────────────────────────
# Didapatkan dari: https://md.fonnte.com/ (Menu Device)
FONNTE_TOKEN=your_fonnte_token_here
FONNTE_DEVICE=628xxxxxxxxxxx
FONNTE_TARGET_NUMBER=628xxxxxxxxxxx
VITE_FONNTE_TOKEN=your_fonnte_token_here
VITE_FONNTE_DEVICE=628xxxxxxxxxxx

# ─── Telegram Bot API ────────────────────────────────────────────────────────
# Didapatkan dari: @BotFather di Telegram
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
VITE_TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here

# ─── Google Firebase Configuration ───────────────────────────────────────────
# Didapatkan dari: Firebase Console → Project Settings → General → Web apps
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_STORAGE_BUCKET=your-project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_firebase_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# ─── Soketi WebSocket & Redis ────────────────────────────────────────────────
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=

SOKETI_HOST=127.0.0.1
SOKETI_PORT=6001
SOKETI_APP_ID=smart-riayah-app
SOKETI_APP_KEY=smart-riayah-key
SOKETI_APP_SECRET=your_soketi_app_secret_here

VITE_SOKETI_HOST=127.0.0.1
VITE_SOKETI_PORT=6001
VITE_SOKETI_APP_KEY=smart-riayah-key
VITE_SOKETI_USE_TLS=false

# ─── Server Backend ──────────────────────────────────────────────────────────
SERVER_PORT=5000
NODE_ENV=development

# ─── MongoDB Database (MongoDB Atlas Cloud / MongoDB Compass Local) ──────────
# Untuk MongoDB Compass Lokal di Laptop: mongodb://127.0.0.1:27017/smart_riayah
# Untuk MongoDB Atlas (Sinkron Vercel + Compass): mongodb+srv://<username>:<password>@<cluster>.mongodb.net/smart_riayah?retryWrites=true&w=majority
MONGODB_URI=mongodb://127.0.0.1:27017/smart_riayah
MONGODB_DB_NAME=smart_riayah
