# ─── Smart Riayah Backend — Environment Variables ────────────────────────────

# Google Gemini AI API Key
VITE_GEMINI_API_KEY=your_gemini_api_key_here

# DeepSeek AI API Key
VITE_DEEPSEEK_API_KEY=your_deepseek_api_key_here

# ─── Opsi A: Supabase (DIREKOMENDASIKAN untuk production) ─────────────────────
# Cara mendapatkan:
#   1. Login ke https://supabase.com/dashboard
#   2. Pilih project → Settings → Database
#   3. Scroll ke "Connection string" → pilih tab "URI"
#   4. Copy string yang bentuknya: postgresql://postgres:[PASSWORD]@db.[PROJECT-REF].supabase.co:5432/postgres
#
DATABASE_URL=postgresql://postgres:[YOUR-PASSWORD]@db.[YOUR-PROJECT-REF].supabase.co:5432/postgres

# ─── Opsi B: PostgreSQL Lokal (untuk development di komputer) ────────────────
# Aktif jika DATABASE_URL tidak diisi
DB_HOST=localhost
DB_PORT=5432
DB_NAME=smart_riayah_db
DB_USER=postgres
DB_PASSWORD=your_local_password_here

# ─── Backend Server ───────────────────────────────────────────────────────────
SERVER_PORT=5000
NODE_ENV=development
