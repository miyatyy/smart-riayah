{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/osis/reports",
      "destination": "/api/mongo/osis-reports"
    },
    {
      "source": "/api/ai/logs",
      "destination": "/api/mongo/ai-logs"
    },
    {
      "source": "/api/mongodb/health",
      "destination": "/api/mongo/health"
    },
    {
      "source": "/api/(.*)",
      "destination": "/server/index.js"
    },
    {
      "source": "/((?!api/|images/|assets/|vite\\.svg|favicon\\.ico).*)",
      "destination": "/index.html"
    }
  ]
}
